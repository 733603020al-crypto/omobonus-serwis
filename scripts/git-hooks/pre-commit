#!/bin/sh
# Защита сайта: коммитить можно только в ветки test и pages/* и только в репозитории сайта (omobonus-serwis).
# Обход на один раз (только по прямому разрешению владельца): OMOBONUS_ALLOW_BRANCH=1 git commit ...
[ "$OMOBONUS_ALLOW_BRANCH" = "1" ] && exit 0
branch=$(git symbolic-ref --short -q HEAD)
origin=$(git remote get-url origin 2>/dev/null)
case "$origin" in
  *omobonus-serwis*) ;;
  *) echo "ЗАПРЕТ: это не репозиторий сайта omobonus-serwis (origin: $origin)." >&2; exit 1 ;;
esac
case "$branch" in
  test|pages/*) exit 0 ;;
  master) echo "ЗАПРЕТ: master — основная версия сайта, коммиты только в test." >&2 ;;
  "") echo "ЗАПРЕТ: коммит вне ветки (detached HEAD). Сайт — только test или pages/*." >&2 ;;
  *) echo "ЗАПРЕТ: ветка '$branch' не для сайта. Разрешены: test, pages/*." >&2 ;;
esac
exit 1
