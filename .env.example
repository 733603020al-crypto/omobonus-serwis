# SMTP Configuration (used by /api/send-email via nodemailer)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here

# Email настройки (опционально, есть значения по умолчанию в коде)
# дрес отправителя
SMTP_FROM=serwis@omobonus.com.pl

# дрес получателя (можно указать несколько через запятую)
SMTP_TO=serwis@omobonus.com.pl
